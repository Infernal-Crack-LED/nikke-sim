.DS_Store
# secrets / local env
.env

# local git credential tooling (machine-specific, not project source)
.git-credential-pat.sh

# node
node_modules

# build output (regenerated from source via vite build)
dist/

# compiled server bundle (npm run build:server) + dynamic-render cache
dist-server/
.cache/

# DPS-chart matrix artifact — regenerated on every build/deploy (npm prebuild)
web/public/dpschart.json
web/public/burstgen.json
web/public/burstcdr.json
web/public/sustain.json
web/public/bufferchart.json

# ephemeral probe-processing workspace (frame extractions, regenerable from the
# videoSec anchors in docs/probe-data/*.json; never source of truth)
scratchpad/

docs/probes
docs/data/ranks
docs/handoffs/closed
docs/closed

# local-only agent settings
.claude/settings.local.json

# blind kit-rebuild test — generated artifacts (regenerable from build-packet.ts);
# only the script + prompt templates + README are tracked
scripts/blind-rebuild/packets/
scripts/blind-rebuild/truth/
scripts/blind-rebuild/reconstructions/
scripts/blind-rebuild/results/

scripts/probe/__pycache__
scripts/probe/.venv
# cross-family dispatch scratch (packets, redacted types, REQUEST.md) stays untracked;
# the s*-result.json evidence is committable (owner ruling 2026-07-26) — un-ignored so
# lint-staged's post-task `git add` (no -f) does not refuse the force-added results.
scripts/kit-autonomy/cross-family/**/*
!scripts/kit-autonomy/cross-family/*/
!scripts/kit-autonomy/cross-family/*/*-result.json

.kimi-code/local.toml
# Local unit-card layout previews (scripts/render-unit-card.ts) — dev eyes only.
.preview/
